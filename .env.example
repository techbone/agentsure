# Public Arc endpoints. Override with a managed provider in hosted environments.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_WS_URL=wss://rpc.quicknode.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.io

# Safe local/testnet defaults. Mainnet runners require every address explicitly and do not fall back
# to these values.
NEXT_PUBLIC_PROTECTION_MANAGER_ADDRESS=0x3e4E4A3A5A0f0fb908de6D380d817b6579FFDbF5
NEXT_PUBLIC_DEMO_RISK_VAULT_ADDRESS=0xa70344cEeA5598B836B148B0d83b19eE988b4599

# Never commit signing credentials. Production values belong in a secrets manager.
GUARDIAN_PRIVATE_KEY=
GUARDIAN_CHAIN_ID=5042002
GUARDIAN_EXPECTED_ADDRESS=0x8125e77Ef9A7db6Ac0ae13a9139C08044C702523
GUARDIAN_KEYSTORE_ACCOUNT=agentsure-testnet-guardian
GUARDIAN_MANAGER_ADDRESS=0x3e4E4A3A5A0f0fb908de6D380d817b6579FFDbF5
GUARDIAN_START_BLOCK=63052386
GUARDIAN_STATE_PATH=.data/guardian-state.json
GUARDIAN_BLOCK_BATCH_SIZE=2000
GUARDIAN_BACKFILL_DELAY_MS=500
GUARDIAN_POLL_INTERVAL_MS=1000
GUARDIAN_LOG_LEVEL=info
GUARDIAN_EXIT_SLIPPAGE_BPS=100
GUARDIAN_RETRY_ATTEMPTS=6
GUARDIAN_RETRY_BASE_DELAY_MS=500
GUARDIAN_BIND_HOST=127.0.0.1
GUARDIAN_HTTP_PORT=9464
TREASURY_ADDRESS=

# Arc Mainnet lifecycle values are filled from the verified deployment manifest. The runner refuses
# mainnet execution unless every address is explicit and the acknowledgement value is present.
AGENTSURE_E2E_NETWORK=testnet
AGENTSURE_E2E_ACKNOWLEDGE_MAINNET=
AGENTSURE_AGENT_WALLET=
AGENTSURE_ADMIN_KEYSTORE=
AGENTSURE_TREASURY=
AGENTSURE_LOSS_SINK=0x000000000000000000000000000000000000dEaD
