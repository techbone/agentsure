# Public Arc endpoints. Override with a managed provider in hosted environments.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_WS_URL=wss://rpc.quicknode.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.io

# Deployed addresses are added after each verified deployment.
NEXT_PUBLIC_PROTECTION_MANAGER_ADDRESS=
NEXT_PUBLIC_DEMO_RISK_VAULT_ADDRESS=

# Never commit signing credentials. Production values belong in a secrets manager.
GUARDIAN_PRIVATE_KEY=
TREASURY_ADDRESS=
